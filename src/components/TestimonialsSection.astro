---
import EmblaArrowButtons from './EmblaArrowButtons.astro';
const baseUrl = "https://assets.venusconstructiongroup.ca/";
type TestimonialSource = "Google" | "Yandex" | "2GIS";

interface Testimonial {
	id: number;
	name: string;
	content: string;
	avatar: string;
	images?: string[];
	rating: number;
	date: string;
	source: TestimonialSource;
}

const testimonial_source_links: Record<TestimonialSource, string> = {
	"Google": "https://www.google.com/maps/place/Venus+BuildWorks/@43.2200334,-79.8988587,14.45z/data=!4m8!3m7!1s0xcb23ccebf011149:0x25aec34b8e729696!8m2!3d43.2219344!4d-79.9152255!9m1!1b1!16s%2Fg%2F11y481zhds?entry=ttu&g_ep=EgoyMDI2MDEyMS4wIKXMDSoKLDEwMDc5MjA3MUgBUAM%3D",
	"Yandex": "#", // Add Yandex link when available
	"2GIS": "#", // Add 2GIS link when available
};
const testimonials: Testimonial[] = [
	{
		id: 1,
		name: "Rosanne Vieta",
		content: "To Thomas, Kevin, and crew,\nWe are very satisfied with the workmanship, professional, and friendly attitudes of everyone on your team. The fence looks great. You all worked very hard through the weekend and holiday to complete 154 linear ft of fence. We enjoyed the process because they cared to make us happy and satisfied with the final results. We liked it so much we added lights. We would gladly call them again. Take care, Rosanne and Mo",
		avatar: "testimonials/Rosanne_Vieta/RosanneVieta.webp",
		images:	[
			"testimonials/Rosanne_Vieta/RosanneVieta-1.webp",
			"testimonials/Rosanne_Vieta/RosanneVieta-2.webp",

		],
		rating: 5,
		date: "2025-03-18",
		source: "Google",
	},
	{
		id: 2,
		name: "Megan Warne",
		content: "We used Venus Fence after seeing their team working on other projects in our neighbourhood. They were very responsive and gave us a beautiful new fence with gate to our yard. They were friendly and very attentive to our needs. I will reach out to them again if we have another project, and I would recommend them to others.",
		avatar: "testimonials/Megan_Warne/Megan_Warne.webp",
		rating: 5,
		date: "2025-02-05",
		source: "Google",
	},
	{
		id: 3,
		name: "Martha Parker",
		content: "We hired Venus Fencing after seeing the their work around the neighbourhood. They removed our old deck and fence and built everything new and the results are fantastic. Thomas, Kevin and their team were prompt, professional, and easy to work with from start to finish.\nThey were super accommodating when we made a few changes to the scope along the way. Thomas even suggested some great tweaks to our original design and made them happen without any extra charges. You can tell he really cares about the work and his crew.\nThe craftsmanship and attention to detail were excellent — everything looks beautiful and was done right. We’d absolutely recommend Venus Fencing and will definitely be calling them again for future projects!",
		avatar: "testimonials/Martha_Parker/Martha_Parker.webp",
		rating: 5,
		date: "2025-03-1",
		source: "Google",
	},
	{
		id: 4,
		name: "Roy",
		content:"Fantastic fence at a GREAT price!\nVenus fencing and deck replaced our old rotting fence with a beautiful new fence.  The work was completed efficiently and on budget.  The workers were friendly and polite.  When our neighbours asked for a piece to be replaced they did so promptly.\nHighly recommended!",
		avatar: "testimonials/Roy/Roy.webp",
		images:	[
			"testimonials/Roy/Roy-1.webp"
		],
		rating: 5,
		date: "2025-01-10",
		source: "Google",
	},
	{
		id: 5,
		name: "A J",
		content:"New Deck Installed, happy with the completed deck, I had a quote within 24 hours of calling them & the new deck was installed with stairs & railings by the end of the next week. The work site was tidy & clean when the job was finished & the workers are very polite & friendly & happy to help :)  I love the new deck & it's safe & sturdy!!   5***** REVIEW",
		avatar: "testimonials/A_J/A_J.webp",
		rating: 5,
		date: "2025-05-10",
		source: "Google",
	},
	{
		id: 6,
		name: "Michael Brown",
		content:"Great workmanship and very efficient. Their team is always polite and friendly. We have used them for several jobs on our properties, I would highly recommend them.\nMike B.",
		avatar: "testimonials/Michael_Brown/Michael_Brown.webp",
		rating: 5,
		date: "2025-01-1",
		source: "Google",
	},
	{
		id: 7,
		name: "Kharche Manish",
		content:"They did a fantastic job and was on time.\nGave me a realistic estimate and excellent communication, keeping me posted about the progress. Very good after sales service.",		
		avatar: "testimonials/Kharche_Manish/Kharche_Manish.webp",
		rating: 5,
		date: "2025-01-1",
		source: "Google",
	}
	
];

const formatDate = (dateString: string): string => {
	const date = new Date(dateString);
	return new Intl.DateTimeFormat("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}).format(date);
};
---

<section id="testimonials" class="embla no-padding" data-testimonials-carousel>
	<!-- Header Row - Title and Arrows -->
	<div class="testimonial-slider__header">
		<div class="testimonial-slider__header-content">
			<h2>Testimonials</h2>
		</div>
		<!-- Carousel Controls -->
		<div class="testimonial-slider__controls">
			<EmblaArrowButtons />
		</div>
	</div>

	<div
		class="embla__viewport overflow-y-visible overflow-x-hidden pb-6"
	>
		<div class="embla__container">
			{testimonials.map((testimonial) => (
				<div class="embla__slide active:scale-96 transition-transform duration-300 ease-out">
					<div class="m-3">
						<a
							href={testimonial_source_links[testimonial.source]}
							target="_blank"
							rel="noopener noreferrer"
							class="testimonial-card"
						>
							<div class="testimonial-card__external-link">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
									<polyline points="15 3 21 3 21 9" />
									<line x1="10" x2="21" y1="14" y2="3" />
								</svg>
							</div>
							{testimonial.images && testimonial.images.filter(img => img && img.trim()).length > 0 && (
								<div class="testimonial-card__images mb-4">
									{testimonial.images.filter(img => img && img.trim()).map((image, index) => (
										<img
											src={baseUrl + image}
											alt={`${testimonial.name} testimonial image ${index + 1}`}
											class="testimonial-card__image"
											loading="lazy"
										/>
									))}
								</div>
							)}
							<p class="mb-6 line-clamp-10 whitespace-pre-line">{testimonial.content}</p>
							<div class="flex items-center">
								<div class="w-12 h-12 rounded-full mr-4 relative overflow-hidden">
									<img
										src={baseUrl + testimonial.avatar}
										alt={testimonial.name}
										class="object-cover w-full h-full"
										loading="eager"
									/>
								</div>
								<div class="flex flex-col">
									<div class="flex items-center gap-3">
										<p class="font-medium">{testimonial.name}</p>
										{testimonial.source === "Google" && (
											<svg
												class="shrink-0"
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="currentColor"
											>
												<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
												<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
												<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
												<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
											</svg>
										)}
										{testimonial.source === "Yandex" && (
											<svg
												class="shrink-0"
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="currentColor"
											>
												<path d="M13.7 17.3h-2.1V6.7h-1.2c-2.2 0-3.4.9-3.4 2.6 0 1.7.9 2.5 2.6 3.4l1.7 1-3.5 5.2H5.5l3.1-4.6c-2.1-1.2-3.3-2.5-3.3-4.9C5.3 6.6 7.3 5 10.4 5h5.3v12.3z" fill="currentColor"/>
											</svg>
										)}
										{testimonial.source === "2GIS" && (
											<svg
												class="shrink-0"
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="currentColor"
											>
												<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#4CAF50"/>
											</svg>
										)}
									</div>
									{testimonial.date && (
										<p class="text-sm text-muted-foreground mt-1">
											{formatDate(testimonial.date)}
										</p>
									)}
								</div>
							</div>
						</a>
					</div>
				</div>
			))}
		</div>
	</div>

	<!-- Dot indicators positioned below the carousel -->
	<div class="embla__dots-container">
		<div class="embla__dots">
			<!-- Dots will be dynamically generated by JavaScript -->
		</div>
	</div>
</section>

<style>
	section.embla {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		--slide-height: 19rem;
		--slide-spacing: 0rem;
		--slide-size: 45ch;
		overflow-x: hidden;
		overflow-y: visible;
		position: relative;
		contain: none;
	}

	@media (max-width: 640px) {
		section.embla {
			--slide-size: 34ch;
		}
	}

	.embla__viewport {
		overflow-x: hidden;
		overflow-y: visible;
		width: 100%;
		min-width: 0;
		position: relative;
		clip-path: none;
	}

	.embla__container {
		display: flex;
		touch-action: pan-y pinch-zoom;
		margin-left: calc(var(--slide-spacing) * -1);
		margin-bottom: 1.5rem;
	}

	.embla__slide {
		transform: translate3d(0, 0, 0);
		flex: 0 0 var(--slide-size);
		position: relative;
		width: var(--slide-size);
		max-width: var(--slide-size);
		padding-left: var(--slide-spacing);
	}

	.testimonial-slider__header-content,
	.product-slider__header-content {
		padding-top: 0.375rem;
	}

	.testimonial-slider__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
		padding: 0 var(--section-padding-x);
		gap: 1rem;
		flex-wrap: wrap;
	}

	.testimonial-slider__header-content {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
	}

	.testimonial-slider__header-content h2 {
		margin: 0;
		word-wrap: break-word;
		overflow-wrap: break-word;
		max-width: 100%;
	}

	.testimonial-slider__controls {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		min-width: 0;
	}

	.testimonial-slider__controls :global(.embla__buttons) {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6rem;
		align-items: center;
		flex-wrap: nowrap;
	}

	:global(.embla__buttons) {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6rem;
		align-items: center;
	}

	:global(.embla__button) {
		-webkit-tap-highlight-color: rgba(var(--text-high-contrast-rgb-value), 0.5);
		-webkit-appearance: none;
		appearance: none;
		touch-action: manipulation;
		color: var(--foreground);
	}

	:global(.embla__button:hover:not(:disabled)) {
		background-color: var(--muted);
		border-color: var(--primary);
		color: var(--primary);
	}

	:global(.embla__button:disabled) {
		color: var(--muted);
		cursor: not-allowed;
	}

	.embla__dots-container {
		display: flex;
		justify-content: center;
	}

	:global(.embla__dots) {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.2rem;
	}

	:global(.embla__dot) {
		-webkit-tap-highlight-color: oklch(var(--primary));
		-webkit-appearance: none;
		appearance: none;
		touch-action: manipulation;
		background: transparent;
		border: 0;
		padding: 0;
		margin: 0;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		transition: var(--transition-standard);
		width: 2.6rem;
		height: 2.6rem;
	}

	:global(.embla__dot:after) {
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 50%;
		display: flex;
		align-items: center;
		content: "";
		background-color: var(--muted);
		transition: var(--transition-standard);
	}

	:global(.embla__dot:hover) {
		background-color: color-mix(in oklch, var(--muted) 40%, transparent);
	}

	:global(.embla__dot--selected:after) {
		background-color: var(--primary);
	}

	:global(.embla__dot--small) {
		width: 1.8rem;
		height: 1.8rem;
	}

	:global(.embla__dot--small:after) {
		width: 0.8rem;
		height: 0.8rem;
	}

	.testimonial-card {
		border-radius: var(--radius);
		border: 2px solid var(--border);
		padding: 1.5rem;
		display: block;
		text-decoration: none;
		color: inherit;
		cursor: pointer;
		transition: var(--transition-standard);
		transform: scale(1);
		position: relative;
	}

	.testimonial-card:hover {
		transform: scale(1.02);
		box-shadow:
			0 10px 25px -5px rgba(0, 0, 0, 0.1),
			0 8px 10px -6px rgba(0, 0, 0, 0.1);
	}

	.testimonial-card__external-link {
		position: absolute;
		bottom: 1rem;
		right: 1rem;
		color: var(--muted-foreground);
		opacity: 0.4;
		transition: var(--transition-standard);
		pointer-events: none;
	}

	.testimonial-card:hover .testimonial-card__external-link {
		opacity: 1;
		transform: scale(1.1);
		color: var(--primary);
	}

	.testimonial-card__images {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		gap: 0.75rem;
		width: 100%;
	}

	.testimonial-card__image {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: calc(var(--radius) * 0.75);
		border: 1px solid var(--border);
		transition: var(--transition-standard);
		background-color: var(--muted);
	}

	.testimonial-card:hover .testimonial-card__image {
		border-color: var(--primary);
		opacity: 0.9;
	}

	@media (max-width: 640px) {
		:global(.embla__buttons) {
			gap: 0.4rem;
		}

		.testimonial-slider__controls {
			display: none;
		}
	}
</style>

<script>
	// @ts-ignore - embla-carousel is installed and will be available at runtime
	import EmblaCarousel from 'embla-carousel';

	// Initialize carousel on page load
	function initCarousel() {
		const carouselSection = document.querySelector('[data-testimonials-carousel]');
		if (!carouselSection) return;

		const viewportNode = carouselSection.querySelector('.embla__viewport') as HTMLElement;
		const prevButton = carouselSection.querySelector('.embla__button--prev') as HTMLButtonElement;
		const nextButton = carouselSection.querySelector('.embla__button--next') as HTMLButtonElement;
		const dotsContainer = carouselSection.querySelector('.embla__dots') as HTMLElement;

		if (!viewportNode) return;

		// Initialize Embla
		const emblaApi = EmblaCarousel(viewportNode, { 
			loop: true,
			align: 'start'
		});

		// Update button states
		const updateButtons = () => {
			if (prevButton) {
				prevButton.disabled = !emblaApi.canScrollPrev();
			}
			if (nextButton) {
				nextButton.disabled = !emblaApi.canScrollNext();
			}
		};

		// Update dot states
		const updateDots = () => {
			if (!dotsContainer) return;
			
			const dots = dotsContainer.querySelectorAll('.embla__dot');
			const selectedIndex = emblaApi.selectedScrollSnap();
			
			dots.forEach((dot, index) => {
				if (index === selectedIndex) {
					dot.classList.add('embla__dot--selected');
				} else {
					dot.classList.remove('embla__dot--selected');
				}
			});
		};

		// Create dots
		const createDots = () => {
			if (!dotsContainer) return;
			
			const scrollSnaps = emblaApi.scrollSnapList();
			dotsContainer.innerHTML = '';
			
			scrollSnaps.forEach((_, index) => {
				const dot = document.createElement('button');
				dot.className = 'embla__dot bg-transparent flex no-underline cursor-pointer border-0 p-0 m-0 items-center justify-center rounded-full transition-standard w-[2.6rem] h-[2.6rem]';
				dot.type = 'button';
				dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
				
				dot.addEventListener('click', () => {
					emblaApi.scrollTo(index);
				});
				
				dotsContainer.appendChild(dot);
			});
			
			updateDots();
		};

		// Event listeners
		if (prevButton) {
			prevButton.addEventListener('click', () => {
				emblaApi.scrollPrev();
			});
		}

		if (nextButton) {
			nextButton.addEventListener('click', () => {
				emblaApi.scrollNext();
			});
		}

		// Listen to Embla events
		emblaApi.on('select', () => {
			updateButtons();
			updateDots();
		});

		emblaApi.on('reInit', () => {
			updateButtons();
			createDots();
		});

		// Initial setup
		createDots();
		updateButtons();
	}

	// Initialize on page load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initCarousel);
	} else {
		initCarousel();
	}

	// Re-initialize on Astro page navigation (if using View Transitions)
	document.addEventListener('astro:page-load', initCarousel);
</script>
