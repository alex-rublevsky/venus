---
import { Image } from "astro:assets";
import { galleryCategories } from "../data/galleryData.ts";
import ScrollTextReveal from "./ScrollTextReveal";

interface Props {
    categories?: typeof galleryCategories;
    baseUrl?: string;
    showTitle?: boolean;
    maxImagesPerCategory?: number;
    categoryIndexOffset?: number;
    insidePerspectiveWrapper?: boolean;
}

const {
    categories = galleryCategories,
    baseUrl = "https://assets.venusconstructiongroup.ca/",
    showTitle = true,
    maxImagesPerCategory = Infinity,
    categoryIndexOffset = 0,
    insidePerspectiveWrapper = false,
} = Astro.props;

// Distribute items into columns matching CSS columns' sequential fill behavior
function distributeIntoColumns<T>(items: T[], numColumns: number): T[][] {
    const columns: T[][] = Array.from({ length: numColumns }, () => []);
    const base = Math.floor(items.length / numColumns);
    const remainder = items.length % numColumns;
    let cursor = 0;
    for (let col = 0; col < numColumns; col++) {
        const count = base + (col < remainder ? 1 : 0);
        for (let i = 0; i < count; i++) {
            columns[col].push(items[cursor++]);
        }
    }
    return columns;
}
---

<section id="gallery" class="gallery-section py-16">
    <div class="mx-auto space-y-16 w-full">
        {
            categories.map((category, categoryIndex) => (
                <div
                    class="category-section"
                    id={`gallery-${categoryIndexOffset + categoryIndex}`}
                >
                    {showTitle && (
                        <h2 class="gallery-title text-4xl font-bold mb-8 text-center">
                            {category.title}
                        </h2>
                    )}
                    <div class="gallery-description mb-8">
                        <ScrollTextReveal
                            paragraph={category.description}
                            insidePerspectiveWrapper={insidePerspectiveWrapper}
                            client:load
                        />
                    </div>
                    {/* Mobile: manual flex columns to avoid CSS columns + view transition bug */}
                    <div class="flex gap-3 md:hidden">
                        {distributeIntoColumns(
                            category.images.slice(0, maxImagesPerCategory),
                            2,
                        ).map((column) => (
                            <div class="flex flex-col gap-2 flex-1">
                                {column.map((image) => {
                                    const imageSrc = baseUrl + image.src;
                                    return (
                                        <button
                                            class={`overflow-hidden rounded-lg shadow-lg hover:shadow-xl w-full border-0 p-0 bg-transparent ${insidePerspectiveWrapper ? "gallery-image-button-perspective" : "gallery-image-button"}`}
                                            data-lightbox-src={imageSrc}
                                            data-image-alt={image.alt}
                                        >
                                            <Image
                                                inferSize
                                                src={imageSrc}
                                                alt={image.alt}
                                                class="w-full h-auto gallery-thumbnail"
                                                data-splash-critical={
                                                    categoryIndex === 0
                                                        ? ""
                                                        : undefined
                                                }
                                                loading={
                                                    categoryIndex === 0
                                                        ? "eager"
                                                        : "lazy"
                                                }
                                                decoding="async"
                                            />
                                        </button>
                                    );
                                })}
                            </div>
                        ))}
                    </div>
                    {/* Tablet+: original CSS columns layout */}
                    <div class="hidden md:block md:columns-3 lg:columns-4 gap-3">
                        {category.images
                            .slice(0, maxImagesPerCategory)
                            .map((image) => {
                                const imageSrc = baseUrl + image.src;
                                return (
                                    <div class="pb-2 break-inside-avoid">
                                        <button
                                            class={`overflow-hidden rounded-lg shadow-lg hover:shadow-xl w-full border-0 p-0 bg-transparent ${insidePerspectiveWrapper ? "gallery-image-button-perspective" : "gallery-image-button"}`}
                                            data-lightbox-src={imageSrc}
                                            data-image-alt={image.alt}
                                        >
                                            <Image
                                                inferSize
                                                src={imageSrc}
                                                alt={image.alt}
                                                class="w-full h-auto gallery-thumbnail"
                                                data-splash-critical={
                                                    categoryIndex === 0
                                                        ? ""
                                                        : undefined
                                                }
                                                loading={
                                                    categoryIndex === 0
                                                        ? "eager"
                                                        : "lazy"
                                                }
                                                decoding="async"
                                            />
                                        </button>
                                    </div>
                                );
                            })}
                    </div>
                </div>
            ))
        }
    </div>
</section>

<dialog id="lightbox" class="lightbox-dialog">
    <img id="lightbox-image" src="" alt="" class="lightbox-image" />
</dialog>

<script>
    import { spring } from "motion";

    const lightbox = document.getElementById("lightbox") as HTMLDialogElement;
    const lightboxImage = document.getElementById(
        "lightbox-image",
    ) as HTMLImageElement;
    const galleryButtons = document.querySelectorAll(
        ".gallery-image-button, .gallery-image-button-perspective",
    );

    let currentThumbnailImg: HTMLImageElement | null = null;
    let activeTransition: ViewTransition | null = null;
    let pendingClose = false;

    // Image preload cache for smooth transitions
    const imageCache = new Map<string, HTMLImageElement>();
    const isTouchDevice =
        "ontouchstart" in window || navigator.maxTouchPoints > 0;

    // Generate spring animation and inject CSS
    const springString = spring(0.27, 0.26).toString();
    const springMatch = springString.match(/^(\d+(?:\.\d+)?m?s)\s+(.+)$/);
    const springDuration = springMatch ? springMatch[1] : "750ms";
    const springEasing = springMatch ? springMatch[2] : "ease-out";

    const styleElement = document.createElement("style");
    styleElement.textContent = `
        ::view-transition-group(gallery-image) {
            animation-duration: ${springDuration} !important;
            animation-timing-function: ${springEasing} !important;
        }
        ::view-transition-old(gallery-image),
        ::view-transition-new(gallery-image) {
            animation-duration: ${springDuration} !important;
            animation-timing-function: ${springEasing} !important;
        }
    `;
    document.head.appendChild(styleElement);

    // Custom cursor management — skip entirely on touch devices
    function showCustomCursor() {
        if (isTouchDevice) return;
        window.dispatchEvent(
            new CustomEvent("custom-cursor-show", {
                detail: {
                    mode: "lottie",
                    lottieAnimation: "/animations/eyes-cursor.json",
                    size: 70,
                },
            }),
        );
    }

    function hideCustomCursor() {
        if (isTouchDevice) return;
        window.dispatchEvent(new CustomEvent("custom-cursor-hide"));
    }

    // Preload image on hover for instant transitions
    function preloadImage(src: string) {
        if (imageCache.has(src)) return;
        const img = new Image();
        img.src = src;
        imageCache.set(src, img);
    }

    // Ensure image is loaded and decoded before transition
    async function ensureImageLoaded(src: string): Promise<HTMLImageElement> {
        let img = imageCache.get(src);
        if (!img) {
            img = new Image();
            img.src = src;
            imageCache.set(src, img);
        }
        await img.decode();
        return img;
    }

    // Freeze scroll-driven perspective animations during view transitions.
    // Without this, startViewTransition() triggers style recalculation that
    // briefly resets the animation to its initial rotated frame (known spec issue).
    const perspectiveElements = document.querySelectorAll<HTMLElement>(
        "[data-perspective-section]",
    );

    function freezePerspective() {
        perspectiveElements.forEach((el) => {
            el.style.transform = getComputedStyle(el).transform;
            el.style.animation = "none";
        });
    }

    function unfreezePerspective() {
        perspectiveElements.forEach((el) => {
            el.style.transform = "";
            el.style.animation = "";
        });
    }

    // Freeze scroll-driven appear animations on gallery buttons during view transitions.
    // Without this, startViewTransition() recalculates styles and resets the
    // scroll-driven animation, causing a visible flash (opacity/scale jump).
    function freezeGalleryAnimations() {
        galleryButtons.forEach((btn) => {
            const el = btn as HTMLElement;
            const computed = getComputedStyle(el);
            el.style.opacity = computed.opacity;
            el.style.scale = computed.scale;
            el.style.animation = "none";
        });
    }

    function unfreezeGalleryAnimations() {
        galleryButtons.forEach((btn) => {
            const el = btn as HTMLElement;
            el.style.opacity = "";
            el.style.scale = "";
            el.style.animation = "";
        });
    }

    // Scroll lock — blocks wheel + touch without changing scroll position or body layout
    function preventScrollEvent(e: Event) {
        e.preventDefault();
    }

    function lockScroll() {
        document.addEventListener("wheel", preventScrollEvent, {
            passive: false,
        });
        document.addEventListener("touchmove", preventScrollEvent, {
            passive: false,
        });
    }

    function unlockScroll() {
        document.removeEventListener("wheel", preventScrollEvent);
        document.removeEventListener("touchmove", preventScrollEvent);
    }

    async function openLightbox(buttonElement: HTMLButtonElement) {
        const thumbnailImg = buttonElement.querySelector(
            "img.gallery-thumbnail",
        ) as HTMLImageElement;
        const lightboxSrc = buttonElement.getAttribute("data-lightbox-src");
        const imageAlt = buttonElement.getAttribute("data-image-alt");

        if (!thumbnailImg || !lightboxSrc || !imageAlt) return;

        const categorySection = buttonElement.closest(".category-section");
        const categoryTitle =
            categorySection
                ?.querySelector(".gallery-title")
                ?.textContent?.trim() || "unknown";
        window.posthog?.capture("gallery_image_opened", {
            image_src: lightboxSrc,
            image_alt: imageAlt,
            category: categoryTitle,
        });

        currentThumbnailImg = thumbnailImg;
        hideCustomCursor();
        buttonElement.style.transform = "";

        if (!document.startViewTransition) {
            lightboxImage.src = lightboxSrc;
            lightboxImage.alt = imageAlt;
            lockScroll();
            lightbox.showModal();
            return;
        }

        await ensureImageLoaded(lightboxSrc);
        thumbnailImg.style.viewTransitionName = "gallery-image";
        document.documentElement.style.viewTransitionName = "none";
        freezePerspective();
        freezeGalleryAnimations();

        const transition = document.startViewTransition(() => {
            thumbnailImg.style.viewTransitionName = "";
            lightboxImage.src = lightboxSrc;
            lightboxImage.alt = imageAlt;
            lightboxImage.style.viewTransitionName = "gallery-image";
            lockScroll();
            lightbox.showModal();
        });
        activeTransition = transition;

        transition.finished.finally(() => {
            lightboxImage.style.viewTransitionName = "";
            buttonElement.style.transform = "";
            activeTransition = null;

            if (pendingClose) {
                // Skip unfreeze — closeLightbox will manage its own freeze/unfreeze cycle
                pendingClose = false;
                closeLightbox();
            } else {
                unfreezePerspective();
                unfreezeGalleryAnimations();
            }
        });
    }

    function closeLightbox() {
        // If the open transition is still running, queue the close for after it finishes
        if (activeTransition) {
            pendingClose = true;
            return;
        }

        if (!currentThumbnailImg) {
            lightbox.close();
            unlockScroll();
            lightboxImage.src = "";
            return;
        }

        const thumbnailImg = currentThumbnailImg;

        if (!document.startViewTransition) {
            lightbox.close();
            unlockScroll();
            currentThumbnailImg = null;
            lightboxImage.src = "";
            return;
        }

        lightboxImage.style.viewTransitionName = "gallery-image";
        freezePerspective();
        freezeGalleryAnimations();

        const transition = document.startViewTransition(() => {
            lightboxImage.style.viewTransitionName = "";
            thumbnailImg.style.viewTransitionName = "gallery-image";
            lightbox.close();
        });
        activeTransition = transition;

        transition.finished.finally(() => {
            activeTransition = null;
            thumbnailImg.style.viewTransitionName = "";
            unfreezePerspective();
            unfreezeGalleryAnimations();
            unlockScroll();
            currentThumbnailImg = null;
            lightboxImage.src = "";
        });
    }

    galleryButtons.forEach((button) => {
        button.addEventListener("click", (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            openLightbox(target);
        });

        button.addEventListener("mouseenter", () => {
            showCustomCursor();
            const lightboxSrc = (button as HTMLButtonElement).getAttribute(
                "data-lightbox-src",
            );
            if (lightboxSrc) {
                preloadImage(lightboxSrc);
            }
        });

        button.addEventListener("mouseleave", () => {
            hideCustomCursor();
        });
    });

    lightbox.addEventListener("click", () => {
        closeLightbox();
    });

    // Escape key fires 'cancel' on dialogs — handle it so scroll is properly unlocked
    lightbox.addEventListener("cancel", (e: Event) => {
        e.preventDefault();
        closeLightbox();
    });
</script>

<script>
    const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.1,
    };

    const viewedSections = new Set<string>();

    const animateOnScroll = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("animate-in");

                // Track gallery_section_viewed once per section
                const section = entry.target.closest(".category-section");
                const sectionId = section?.id;
                const title = (entry.target as HTMLElement).textContent?.trim();
                if (
                    sectionId &&
                    !viewedSections.has(sectionId) &&
                    entry.target.classList.contains("gallery-title")
                ) {
                    viewedSections.add(sectionId);
                    window.posthog?.capture("gallery_section_viewed", {
                        section_id: sectionId,
                        section_title: title || "unknown",
                    });
                }
            }
        });
    };

    const observer = new IntersectionObserver(animateOnScroll, observerOptions);

    document.addEventListener("DOMContentLoaded", () => {
        const galleryTitles = document.querySelectorAll(".gallery-title");
        const galleryDescriptions = document.querySelectorAll(
            ".gallery-description",
        );

        galleryTitles.forEach((title) => {
            observer.observe(title);
        });

        galleryDescriptions.forEach((description) => {
            observer.observe(description);
        });
    });
</script>

<style>
    .lightbox-dialog {
        inset: 0;
        max-width: 100dvw;
        max-height: 100dvh;
        width: 100dvw;
        height: 100dvh;
        padding: 2rem;
        border: none;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        overscroll-behavior: contain;
        cursor: pointer;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
    }

    @media (max-width: 768px) {
        .lightbox-dialog {
            padding: 1rem;
        }
    }

    .lightbox-dialog:not([open]) {
        display: none;
    }

    .lightbox-dialog::backdrop {
        background-color: rgb(from var(--background) r g b / 0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition:
            backdrop-filter 0.3s ease-out,
            background-color 0.3s ease-out,
            opacity 0.3s ease-out;
        opacity: 1;
    }

    @starting-style {
        .lightbox-dialog[open]::backdrop {
            opacity: 0;
            backdrop-filter: blur(0px);
            -webkit-backdrop-filter: blur(0px);
        }
    }

    @media (max-width: 768px) {
        .lightbox-dialog::backdrop {
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }

        @starting-style {
            .lightbox-dialog[open]::backdrop {
                backdrop-filter: blur(0px);
                -webkit-backdrop-filter: blur(0px);
            }
        }
    }

    .lightbox-image {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        cursor: pointer;
        border-radius: var(--radius-lg);
    }

    .gallery-image-button {
        display: block;
        cursor: pointer;
        animation: appear linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 24%;
        transition: transform 0.2s ease-out;

        /* Only apply hover/active transforms on true hover devices to avoid double-tap on touch */
        @media (hover: hover) and (pointer: fine) {
            cursor: none;
            &:hover {
                transform: scale(1.03);
            }
            &:active {
                transform: scale(0.98);
                transition: transform 0.2s ease-out;
            }
        }

        @media (hover: none) and (pointer: coarse) and (min-width: 1280px) {
            cursor: none;
        }
    }

    .gallery-image-button-perspective {
        display: block;
        cursor: pointer;
        animation: appear linear both;
        animation-timeline: view();
        animation-range: cover -100vh cover -72vh;
        transition: transform 0.2s ease-out;

        /* Only apply hover/active transforms on true hover devices to avoid double-tap on touch */
        @media (hover: hover) and (pointer: fine) {
            cursor: none;
            &:hover {
                transform: scale(1.025);
            }
            &:active {
                transform: scale(0.98);
                transition: transform 0.2s ease-out;
            }
        }

        @media (hover: none) and (pointer: coarse) and (min-width: 1280px) {
            cursor: none;
        }
    }

    @keyframes appear {
        from {
            opacity: 0;
            scale: 0.5;
        }
        to {
            opacity: 1;
            scale: 1;
        }
    }

    .gallery-thumbnail {
        display: block;
        -webkit-user-drag: none;
    }
</style>

<style>
    .gallery-section {
        padding-bottom: 2rem !important;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
    }

    .category-section {
        scroll-margin-top: 4rem;
    }

    .gallery-title,
    .gallery-description {
        opacity: 0;
        transform: translateY(30px);
        filter: blur(10px);
        transition:
            opacity 0.8s ease-out,
            transform 0.8s ease-out,
            filter 0.8s ease-out;
    }

    .gallery-title.animate-in {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
    }

    .gallery-description.animate-in {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
        transition-delay: 0.15s;
    }
</style>

<style is:global>
    html {
        scrollbar-gutter: stable;
    }
</style>
