---
import PerspectiveController from './PerspectiveController.tsx';
---

<div class="perspective-transition-container" data-perspective-container>
    <div class="perspective-section-1" data-perspective-section="1">
        <slot name="section1" />
    </div>
    <div class="perspective-section-2" data-perspective-section="2">
        <slot name="section2" />
    </div>
</div>

<PerspectiveController client:load />

<style>
    .perspective-transition-container {
        position: relative;
        height: 250vh;
    }

    .perspective-section-1 {
        position: sticky;
        top: 0;
        height: 100vh;
        width: 100%;
        z-index: 1;
        will-change: transform;
        transform-origin: center center;
    }

    .perspective-section-1 > :global(section) {
        height: 100%;
        width: 100%;
    }

    .perspective-section-2 {
        position: absolute;
        top: 150vh;
        left: 0;
        right: 0;
        width: 100%;
        min-height: 100vh;
        z-index: 2;
        will-change: transform;
        transform-origin: center center;
        display: flex;
        align-items: center;
    }
    
    .perspective-section-2 > :global(section) {
        padding-bottom: 0 !important;
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
    }
</style>
