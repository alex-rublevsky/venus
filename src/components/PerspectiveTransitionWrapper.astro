---
---

<div class="perspective-transition-container" data-perspective-container>
    <div class="perspective-section-1" data-perspective-section="1">
        <slot name="section1" />
    </div>
    <div class="perspective-section-2" data-perspective-section="2">
        <slot name="section2" />
    </div>
</div>

<style>
    .perspective-transition-container {
        position: relative;
        height: 250vh;
    }

    .perspective-section-1 {
        position: sticky;
        top: 0;
        height: 100vh;
        width: 100%;
        z-index: 1;
        will-change: transform;
        transform-origin: center center;
        animation: section1-perspective linear forwards;
        animation-timeline: scroll(root);
        animation-range: 0vh 150vh;
    }

    .perspective-section-1 > :global(section) {
        height: 100%;
        width: 100%;
    }

    .perspective-section-2 {
        position: absolute;
        top: 150vh;
        left: 0;
        right: 0;
        width: 100%;
        min-height: 100vh;
        z-index: 2;
        will-change: transform;
        transform-origin: center center;
        display: flex;
        align-items: center;
        animation: section2-perspective linear forwards;
        animation-timeline: scroll(root);
        animation-range: 0vh 150vh;
    }
    
    .perspective-section-2 > :global(section) {
        padding-bottom: 0 !important;
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
    }

    @keyframes section1-perspective {
        from {
            transform: scale(1) rotate(0deg);
        }
        to {
            transform: scale(0.8) rotate(-5deg);
        }
    }

    @keyframes section2-perspective {
        from {
            transform: scale(0.8) rotate(5deg);
        }
        to {
            transform: scale(1) rotate(0deg);
        }
    }

    /* Fallback for browsers without scroll-driven animations support */
    @supports not (animation-timeline: scroll()) {
        .perspective-section-1 {
            animation: none;
        }
        
        .perspective-section-2 {
            animation: none;
        }
    }
</style>

<script>
    // Fallback for browsers without scroll-driven animations support
    if (!CSS.supports('animation-timeline: scroll()')) {
        const container = document.querySelector('[data-perspective-container]');
        const section1 = document.querySelector('[data-perspective-section="1"]');
        const section2 = document.querySelector('[data-perspective-section="2"]');
        
        if (container && section1 && section2) {
            let ticking = false;
            
            const updateTransforms = () => {
                const scrollTop = window.scrollY;
                const containerTop = container.offsetTop;
                const containerHeight = container.offsetHeight;
                const viewportHeight = window.innerHeight;
                
                // Calculate scroll progress (0 to 1) based on container position
                // Animation runs from when container enters viewport to 150vh of scroll
                const scrollProgress = Math.max(0, Math.min(1, scrollTop / (150 * viewportHeight / 100)));
                
                // Section 1: scale 1 -> 0.8, rotate 0 -> -5deg
                const scale1 = 1 - (scrollProgress * 0.2);
                const rotate1 = scrollProgress * -5;
                section1.style.transform = `scale(${scale1}) rotate(${rotate1}deg)`;
                
                // Section 2: scale 0.8 -> 1, rotate 5 -> 0deg
                const scale2 = 0.8 + (scrollProgress * 0.2);
                const rotate2 = 5 - (scrollProgress * 5);
                section2.style.transform = `scale(${scale2}) rotate(${rotate2}deg)`;
                
                ticking = false;
            };
            
            const requestTick = () => {
                if (!ticking) {
                    window.requestAnimationFrame(updateTransforms);
                    ticking = true;
                }
            };
            
            // Initial update
            updateTransforms();
            
            // Update on scroll
            window.addEventListener('scroll', requestTick, { passive: true });
            
            // Update on resize
            window.addEventListener('resize', requestTick, { passive: true });
        }
    }
</script>
