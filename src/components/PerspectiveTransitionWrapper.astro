---
---

<div class="perspective-wrapper">
    <div class="perspective-hero-zone" data-perspective-hero>
        <div class="perspective-hero" data-perspective-section="1">
            <slot name="hero" />
        </div>
    </div>

    <div class="perspective-content" data-perspective-section="2">
        <slot name="content" />
    </div>
</div>

<style>
    .perspective-wrapper {
        margin-bottom: -100vh;
    }

    .perspective-hero-zone {
        position: relative;
        height: 200vh;
    }

    .perspective-hero {
        position: sticky;
        top: 0;
        height: 100vh;
        width: 100%;
        z-index: 1;
        will-change: transform;
        transform-origin: center center;
        animation: hero-perspective linear forwards;
        animation-timeline: scroll(root);
        animation-range: 0vh 100vh;
    }

    .perspective-hero > :global(section) {
        height: 100%;
        width: 100%;
    }

    .perspective-content {
        position: relative;
        width: 100%;
        z-index: 2;
        margin-top: 0vh;
        will-change: transform;
        transform-origin: center top;
        transform: scale(0.8) rotate(5deg) translateY(-100vh);
        animation: content-perspective linear forwards;
        animation-timeline: scroll(root);
        animation-range: 30vh 100vh;
    }

    @keyframes hero-perspective {
        from {
            transform: scale(1) rotate(0deg);
        }
        to {
            transform: scale(0.8) rotate(-5deg);
        }
    }

    @keyframes content-perspective {
        from {
            transform: scale(0.8) rotate(5deg) translateY(-100vh);
        }
        to {
            transform: scale(1) rotate(0deg) translateY(-100vh);
        }
    }

    /* Fallback for browsers without scroll-driven animations support */
    @supports not (animation-timeline: scroll()) {
        .perspective-hero {
            animation: none;
        }
        
        .perspective-content {
            animation: none;
        }
    }
</style>

<script>
    // Prevent scroll restoration on page load. fixes the first section being in last frame on refresh
    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);

    // Fallback for browsers without scroll-driven animations support
    if (!CSS.supports('animation-timeline: scroll()')) {
        const hero = document.querySelector('[data-perspective-section="1"]') as HTMLElement;
        const content = document.querySelector('[data-perspective-section="2"]') as HTMLElement;
        
        if (hero && content) {
            let ticking = false;
            
            const updateTransforms = () => {
                const scrollTop = window.scrollY;
                const viewportHeight = window.innerHeight;
                
                // Hero animation: 0 to 100vh
                const heroProgress = Math.max(0, Math.min(1, scrollTop / viewportHeight));
                const scale1 = 1 - (heroProgress * 0.2);
                const rotate1 = heroProgress * -5;
                hero.style.transform = `scale(${scale1}) rotate(${rotate1}deg)`;
                
                // Content animation: 30vh to 100vh (delayed start)
                const contentProgress = Math.max(0, Math.min(1, (scrollTop - (0.3 * viewportHeight)) / (0.7 * viewportHeight)));
                const scale2 = 0.8 + (contentProgress * 0.2);
                const rotate2 = 5 - (contentProgress * 5);
                content.style.transform = `scale(${scale2}) rotate(${rotate2}deg) translateY(-100vh)`;
                
                ticking = false;
            };
            
            const requestTick = () => {
                if (!ticking) {
                    window.requestAnimationFrame(updateTransforms);
                    ticking = true;
                }
            };
            
            // Initial update
            updateTransforms();
            
            // Update on scroll
            window.addEventListener('scroll', requestTick, { passive: true });
            
            // Update on resize
            window.addEventListener('resize', requestTick, { passive: true });
        }
    }
</script>
