---
import { Image } from 'astro:assets';
const baseUrl = "https://assets.venusconstructiongroup.ca/";
import logoSvg from '../data/logotype.svg?raw';
---

<section id="hero" class="hero-section">
    <div class="hero-content">
       
       
        
        <div class="logo-animation-wrapper">
            <!-- Hammer and Nail Animation -->
            <div class="hammer-nail-container">
                <Image
                    src={baseUrl + "misc/nail.webp"}
                    alt="Nail decoration"
                    class="nail-sticking"
                    aria-hidden="true"
                    inferSize
                    loading="eager"
                />
                <Image
                    src={baseUrl + "misc/hammer.webp"}
                    alt="Hammer decoration"
                    class="hammer-flying"
                    aria-hidden="true"
                    inferSize
                    loading="eager"
                />
            </div>
            
            <div class="logo-container">
                <div class="logotype" data-hero-logotype set:html={logoSvg} />
                <!-- Wood texture disabled -->
                <!-- <div class="logo-wood-texture">
                    <img 
                        src={baseUrl + "misc/wood-logo.webp"} 
                        alt="" 
                        class="wood-texture-img"
                        aria-hidden="true"
                    />
                </div> -->
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        overflow: hidden;
    }

    /* Tablet and desktop: position at bottom */
    @media (min-width: 768px) {
        .hero-section {
            justify-content: flex-end;
            padding-bottom: 2rem;
        }
    }

    .hero-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .logo-animation-wrapper {
        width: 100vw;
        position: relative;
        left: 0;
        transform: none;
    }

    .logo-container {
        width: 100%;
        position: relative;
    }

    .logotype :global(svg) {
        width: 100%;
        height: auto;
        display: block;
        color: var(--secondary);
    }
    
    .logotype :global(svg path) {
        fill: currentColor;
    }

    /* Wood texture styles disabled */
    /* .logo-wood-texture {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0;
        mask-image: var(--logo-mask);
        -webkit-mask-image: var(--logo-mask);
        mask-size: 100% 100%;
        -webkit-mask-size: 100% 100%;
        mask-repeat: no-repeat;
        -webkit-mask-repeat: no-repeat;
        mask-position: center;
        -webkit-mask-position: center;
    }

    .wood-texture-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    } */

    /* Enable wood texture fade-in animation after nail lands */
    /* html.splash-revealed .logo-wood-texture.nail-landed {
        animation: wood-logo-fade-in ease-out forwards;
        animation-timeline: --hero-timeline;
        animation-range: contain 58% contain 80%;
    } */

    /* Hammer and Nail Animation */
    .hammer-nail-container {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 88vw;
        height: 0;
        pointer-events: none;
        z-index: -1;
    }

    .nail-sticking {
        position: absolute;
        left: 50%;
        top: -17vw;
        width: 5vw;
        height: auto;
        transform-origin: top center;
        
        /* Start position off-screen - higher up */
        opacity: 0;
        transform: translateX(-45%) translateY(-130dvh);
    }
    
    /* Falling animation after splash */
    html.splash-revealed .nail-sticking {
        opacity: 1;
        animation: nail-fall 1s cubic-bezier(0.34, 0, 0.84, 0) forwards;
    }
    
    /* Enable scroll animation after nail lands - uses scroll(root) for reliability
       (same approach as the section transitions in PerspectiveTransitionWrapper) */
    html.splash-revealed .nail-sticking.nail-landed {
        transform: translateX(-45%) translateY(3vw);
        animation: nail-hammer-in ease-out forwards;
        animation-timeline: scroll(root);
        animation-range: 0vh 80vh;
    }

    .hammer-flying {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 100%;
        height: auto;
        transform-origin: bottom right;
        opacity: 0;
    }
    
    /* Hammer entrance animation after splash dismisses */
    html.splash-revealed .hammer-flying {
        animation: hammer-entrance 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
    }
    
    /* Enable hammer scroll animation after nail lands */
    html.splash-revealed .hammer-flying.nail-landed {
        animation: hammer-entrance 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards,
                   hammer-fly ease-out forwards;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0vh 80vh;
    }

    /* Mobile: extend animation range so the hammer strike plays over more scroll distance.
       The hero is still visible during this range because the second section animates in later. */
    @media (max-width: 767px) {
        html.splash-revealed .nail-sticking.nail-landed {
            animation-range: 0vh 120vh;
        }
        html.splash-revealed .hammer-flying.nail-landed {
            animation-range: normal, 0vh 120vh;
        }
    }

    /* Nail falling from off-screen (gravity effect) */
    @keyframes nail-fall {
        from {
            transform: translateX(-45%) translateY(-130dvh);
        }
        to {
            transform: translateX(-45%) translateY(3vw);
        }
    }
    
    /* Hammer entrance from off-screen right with bounce */
    @keyframes hammer-entrance {
        0% {
            opacity: 0;
            transform: translateX(calc(100% + 50vw)) rotate(225deg) scale(0.5);
        }
        60% {
            opacity: 1;
            transform: translateX(35vw) rotate(225deg) scale(1.1);
        }
        80% {
            transform: translateX(38vw) rotate(225deg) scale(0.5);
        }
        100% {
            opacity: 1;
            transform: translateX(37vw) rotate(225deg) scale(1);
        }
    }
    
    /* Location text fade in and down */
    @keyframes fade-in-down {
        from {
            opacity: 0;
            transform: translateX(-50%) translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    }
    
    /* Scroll-based hammer animation - nail gets pushed deeper on scroll */
    @keyframes nail-hammer-in {
        0% {
            transform: translateX(-45%) translateY(3vw);
        }
        35.6% {
            /* Nail stays still for first portion of scroll */
            transform: translateX(-45%) translateY(3vw);
        }

        51.6% {
            /* Hold in final position - ends higher */
            transform: translateX(-45%) translateY(16.5vw);
        }
   
        100% {
            /* Hold in final position - ends higher */
            transform: translateX(-45%) translateY(16.5vw);
        }
    }

    @keyframes hammer-fly {
        0% {
            opacity: 1;
            transform: translateX(37vw) rotate(70deg);
        }
       
        51.9% {
            opacity: 1;
            transform: translateX(37vw) rotate(0deg);
        }
        100% {
            /* Hold in final position */
            opacity: 1;
            transform: translateX(37vw) rotate(0deg);
        }
    }

    /* Wood texture animation disabled */
    /* @keyframes wood-logo-fade-in {
        0% {
            opacity: 0;
        }
        100% {
            opacity: 1;
        }
    } */

    /* Fallback for browsers without scroll-driven animation support */
    @supports not (animation-timeline: scroll()) {
        .nail-sticking {
            animation: none;
        }
        
        .hammer-flying {
            animation: none;
        }
        
        .hero-section.in-view .nail-sticking {
            animation: nail-hammer-in ease-out 1.2s both;
        }
        
        .hero-section.in-view .hammer-flying {
            animation: hammer-fly ease-out 1.2s both;
        }
    }
</style>

<script is:inline>
    // Fallback for browsers without scroll-driven animations
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
            }
        });
    }, {
        threshold: 0.1
    });

    const heroSection = document.querySelector('.hero-section');
    if (heroSection) {
        observer.observe(heroSection);
    }

    // Enable scroll animations after nail finishes falling
    const nail = document.querySelector('.nail-sticking');
    const hammer = document.querySelector('.hammer-flying');

    if (nail) {
        nail.addEventListener('animationend', function handler(e) {
            if (e.animationName === 'nail-fall') {
                nail.classList.add('nail-landed');
                // Also enable hammer scroll animation
                if (hammer) {
                    hammer.classList.add('nail-landed');
                }
                nail.removeEventListener('animationend', handler);
            }
        });
    }
</script>