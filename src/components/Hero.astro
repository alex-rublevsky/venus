---
const baseUrl = "https://pub-92598708a02144628d401b04dd2b81c7.r2.dev/";
import logoSvg from '../data/logotype.svg?raw';
---

<section id="hero" class="hero-section">
    <div class="hero-sticky-wrapper">
        <p class="absolute top-0 pt-5 mx-auto">Hamilton, ON</p> 
        <div class="hero-content">
           
           
            
            <div class="logo-animation-wrapper">
                <!-- Hammer and Nail Animation -->
                <div class="hammer-nail-container">
                    <img 
                        src={baseUrl + "misc/nail.webp"} 
                        alt="Nail decoration" 
                        class="nail-sticking"
                        aria-hidden="true"
                    />
                    <img 
                        src={baseUrl + "misc/hammer.webp"} 
                        alt="Hammer decoration" 
                        class="hammer-flying"
                        aria-hidden="true"
                    />
                </div>
                
                <div class="logo-container">
                    <div class="logotype" data-hero-logotype set:html={logoSvg} />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        view-timeline-name: --hero-timeline;
        position: relative;
        /* Extended height: full screen + scroll distance for animation */
        height: calc(100vh + 50rem);
        overflow: hidden;
    }

    .hero-sticky-wrapper {
        position: relative;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding-top: 4rem;
        width: 100%;
    }
    
    /* Location text entrance animation */
    .hero-sticky-wrapper > p {
        opacity: 0;
        transform: translateY(-20px);
    }
    
    html.splash-revealed .hero-sticky-wrapper > p {
        animation: fade-in-down 0.6s ease-out 0.7s forwards;
    }

    .hero-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .logo-animation-wrapper {
        width: 100vw;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, calc(-50% + 5rem));
    }

    .logo-container {
        width: 100%;
        position: relative;
    }

    .logotype :global(svg) {
        width: 100%;
        height: auto;
        display: block;
        color: var(--secondary);
    }
    
    .logotype :global(svg path) {
        fill: currentColor;
    }

    /* Hammer and Nail Animation */
    .hammer-nail-container {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 88vw;
        height: 0;
        pointer-events: none;
        z-index: -1;
    }

    .nail-sticking {
        position: absolute;
        left: 50%;
        top: -10vw;
        width: 4.8vw;
        height: auto;
        transform-origin: top center;
        
        /* Start position off-screen - higher up */
        opacity: 0;
        transform: translateX(-45%) translateY(-130vh);
    }
    
    /* Falling animation after splash */
    html.splash-revealed .nail-sticking {
        opacity: 1;
        animation: nail-fall 1.2s cubic-bezier(0.34, 0, 0.84, 0) 0.4s forwards;
    }
    
    /* Enable scroll animation after nail lands - higher specificity */
    html.splash-revealed .nail-sticking.nail-landed {
        /* Keep the landed position, add scroll animation */
        transform: translateX(-45%) translateY(0);
        animation: nail-hammer-in ease-out forwards;
        animation-timeline: --hero-timeline;
        animation-range: entry 0% exit 0%;
    }

    .hammer-flying {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 100%;
        height: auto;
        transform-origin: bottom right;
        opacity: 0;
    }
    
    /* Hammer entrance animation after splash dismisses */
    html.splash-revealed .hammer-flying {
        animation: hammer-entrance 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
    }
    
    /* Enable hammer scroll animation after nail lands */
    html.splash-revealed .hammer-flying.nail-landed {
        animation: hammer-entrance 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards,
                   hammer-fly ease-out forwards;
        animation-timeline: auto, --hero-timeline;
        animation-range: normal, entry 0% exit 0%;
    }

    /* Nail falling from off-screen (gravity effect) */
    @keyframes nail-fall {
        from {
            transform: translateX(-45%) translateY(-130vh);
        }
        to {
            transform: translateX(-45%) translateY(0);
        }
    }
    
    /* Hammer entrance from off-screen right with bounce */
    @keyframes hammer-entrance {
        0% {
            opacity: 0;
            transform: translateX(calc(100% + 50vw)) rotate(225deg) scale(0.5);
        }
        60% {
            opacity: 1;
            transform: translateX(35vw) rotate(225deg) scale(1.1);
        }
        80% {
            transform: translateX(38vw) rotate(225deg) scale(0.95);
        }
        100% {
            opacity: 1;
            transform: translateX(37vw) rotate(225deg) scale(1);
        }
    }
    
    /* Location text fade in and down */
    @keyframes fade-in-down {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Scroll-based hammer animation - nail gets pushed deeper on scroll */
    @keyframes nail-hammer-in {
        0% {
            transform: translateX(-45%) translateY(0);
        }
        74% {
            /* Nail stays still for first 70% of scroll */
            transform: translateX(-45%) translateY(0);
        }
        85% {
            /* Nail goes deeper, but still sticking out - ends higher */
            transform: translateX(-45%) translateY(7.8vw);
        }
        100% {
            /* Hold in final position - ends higher */
            transform: translateX(-45%) translateY(7.8vw);
        }
    }

    @keyframes hammer-fly {
        0% {
            opacity: 0;
            transform: translateX(calc(100% + 20vw)) rotate(225deg);
        }
        /* Movement left happens from 0-25% */
        25% {
            opacity: 1;
            transform: translateX(37vw) rotate(225deg);
        }
        /* Rotation happens from 25-85% */
        85% {
            opacity: 1;
            transform: translateX(37vw) rotate(0deg);
        }
        100% {
            /* Hold in final position */
            opacity: 1;
            transform: translateX(37vw) rotate(0deg);
        }
    }

    /* Fallback for browsers without view() support */
    @supports not (animation-timeline: --hero-timeline) {
        .nail-sticking {
            animation: none;
        }
        
        .hammer-flying {
            animation: none;
        }
        
        .hero-section.in-view .nail-sticking {
            animation: nail-hammer-in ease-out 1.2s both;
        }
        
        .hero-section.in-view .hammer-flying {
            animation: hammer-fly ease-out 1.2s both;
        }
    }
</style>

<script is:inline>
    // Fallback for browsers without scroll-driven animations
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
            }
        });
    }, {
        threshold: 0.1
    });

    const heroSection = document.querySelector('.hero-section');
    if (heroSection) {
        observer.observe(heroSection);
    }
    
    // Enable scroll animations after nail finishes falling
    const nail = document.querySelector('.nail-sticking');
    const hammer = document.querySelector('.hammer-flying');
    
    if (nail) {
        nail.addEventListener('animationend', function handler(e) {
            if (e.animationName === 'nail-fall') {
                nail.classList.add('nail-landed');
                // Also enable hammer scroll animation
                if (hammer) {
                    hammer.classList.add('nail-landed');
                }
                nail.removeEventListener('animationend', handler);
            }
        });
    }
    
</script>