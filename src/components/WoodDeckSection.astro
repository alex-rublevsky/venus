---
import Union from '../data/Union.svg?raw';
import Union1 from '../data/Union-1.svg?raw';
import Union2 from '../data/Union-2.svg?raw';
import Union3 from '../data/Union-3.svg?raw';
import Union4 from '../data/Union-4.svg?raw';

const woodPlanks = [Union, Union1, Union2, Union3, Union4];
---

<section id="wood-deck" class="wood-deck-section">
	<div class="wood-deck-container">
		<div class="wood-row-wrapper">
			<div class="wood-row" data-row="1" data-direction="right">
				{Array.from({ length: 15 }).map((_, i) => (
					<div class="wood-plank" set:html={woodPlanks[(i * 3) % woodPlanks.length]} />
				))}
				{Array.from({ length: 15 }).map((_, i) => (
					<div class="wood-plank" set:html={woodPlanks[(i * 3) % woodPlanks.length]} />
				))}
			</div>
		</div>
		<div class="wood-row-wrapper">
			<div class="wood-row" data-row="2" data-direction="left">
				{Array.from({ length: 15 }).map((_, i) => (
					<div class="wood-plank" set:html={woodPlanks[(i * 2 + 1) % woodPlanks.length]} />
				))}
				{Array.from({ length: 15 }).map((_, i) => (
					<div class="wood-plank" set:html={woodPlanks[(i * 2 + 1) % woodPlanks.length]} />
				))}
			</div>
		</div>
		<div class="wood-row-wrapper">
			<div class="wood-row" data-row="3" data-direction="right">
				{Array.from({ length: 15 }).map((_, i) => (
					<div class="wood-plank" set:html={woodPlanks[(i * 4 + 3) % woodPlanks.length]} />
				))}
				{Array.from({ length: 15 }).map((_, i) => (
					<div class="wood-plank" set:html={woodPlanks[(i * 4 + 3) % woodPlanks.length]} />
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.wood-deck-section {
		overflow: hidden;
		padding: 4rem 0;
		background-color: var(--background);
	}

	.wood-deck-container {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		width: 100%;
	}

	.wood-row-wrapper {
		overflow: hidden;
		width: 100%;
	}

	.wood-row {
		display: flex;
		gap: 0.25rem;
		width: max-content;
		will-change: transform;
	}

	/* Scroll-driven parallax — runs on compositor, zero JS */
	.wood-row[data-direction="right"] {
		transform: translateX(-20%);
		animation: wood-row-right linear both;
		animation-timeline: scroll(root);
	}

	.wood-row[data-direction="left"] {
		transform: translateX(0);
		animation: wood-row-left linear both;
		animation-timeline: scroll(root);
	}

	@keyframes wood-row-right {
		from { transform: translateX(-20%); }
		to { transform: translateX(0); }
	}

	@keyframes wood-row-left {
		from { transform: translateX(0); }
		to { transform: translateX(-20%); }
	}

	.wood-plank {
		width: 18.75rem;
		height: 5.5rem;
		flex-shrink: 0;
		position: relative;
		color: var(--secondary);
	}

	.wood-plank :global(svg) {
		position: absolute;
		top: 50%;
		left: 50%;
		height: 18.75rem;
		width: auto;
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.wood-plank :global(path) {
		fill: currentColor;
	}

	@media (width <= 640px) {
		.wood-plank {
			width: 13.75rem;
			height: 4rem;
		}

		.wood-plank :global(svg) {
			height: 13.75rem;
		}

		.wood-deck-section {
			padding: 3rem 0;
		}
	}

	@supports not (animation-timeline: scroll()) {
		.wood-row[data-direction="right"],
		.wood-row[data-direction="left"] {
			animation: none;
			transform: translateX(-10%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wood-row {
			will-change: auto;
			animation: none !important;
		}
	}
</style>
