---
import { Image } from 'astro:assets';
const baseUrl = "https://assets.venusconstructiongroup.ca/partners/";

const partners = [
{ src: "ford.svg", alt: "Ford" },
	{ src: "Saudi-Aramco.webp", alt: "Saudi Aramco Logo" },
	{ src: "burlington-fence.webp", alt: "Burlington Fence Logo" },
	{ src: "king-fence.webp", alt: "King Fence Logo" },
	{ src: "firmfence.webp", alt: "FirmFence Logo" },
	{ src: "mcfaul.webp", alt: "McFaul Fencing Logo" },

	
{ src: "roma-fence.svg", alt: "Roma Fence" },
];
---

<section id="partners">
	<h3>Our Partners</h3>
	<div class="flex flex-wrap justify-center items-center mt-10 gap-(--space-lg)">
		{partners.map((partner) => (
			<div class="flex align-center justify-center">
				<Image class="max-h-26 md:max-h-30 w-auto max-w-36 md:max-w-46 object-contain grayscale opacity-70 transition-all duration-300 hover:grayscale-0 hover:opacity-100" src={baseUrl + partner.src} alt={partner.alt} loading="lazy" inferSize />
			</div>
		))}
	</div>
</section>