---
---

<div class="nav-wrap">
  <div class="bubble active"></div>
  <div class="bubble hover"></div>
  <nav class="nav">
    <a class="active" href="#gallery-0">House Renovation</a>
    <a href="#gallery-1">Decks</a>
    <a href="#gallery-2">Fences</a>
  </nav>
</div>

<style>
  .nav-wrap {
    border: 1px solid var(--border);
    width: fit-content;
    max-width: calc(100vw - 40px);
    margin: 0 auto;
    border-radius: 500px;
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    box-shadow: inset 10px 0 10px var(--foreground);
    background: linear-gradient(0deg, color-mix(in oklch, var(--foreground) 95%, var(--background) 5%), color-mix(in oklch, var(--foreground) 85%, var(--background) 15%));
    transition: opacity 0.3s ease-out;
    
    &:after {
      content: "";
      display: block;
      position: absolute;
      inset: -5px;
      background: linear-gradient(180deg, var(--border), color-mix(in oklch, var(--foreground) 70%, var(--background) 30%));
      border-radius: 500px;
      z-index: -1;
    }
  }
  
  .nav {
    width: fit-content;
    anchor-name: --nav;
    margin: 4px;
    display: flex;
    flex-wrap: nowrap;
    gap: 2px;
    
    a {
      z-index: 10;
      position: relative;
      display: inline-block;
      padding: 0.4rem 1rem;
      color: var(--background);
      text-decoration: none;
      font-size: 0.9rem;
      white-space: nowrap;
      
      &:before {
        content: "";
        display: block;
        position: absolute;
        inset: 0;
        opacity: 0.2;
      }
      
      &.active {
        anchor-name: --active;
        color: var(--foreground);
      }
      
      &:hover:before {
        anchor-name: --nav;
      }
    }
    
    @media (max-width: 640px) {
      a {
        padding: 10px 16px;
        font-size: 0.85rem;
      }
    }
    
    @media (max-width: 480px) {
      a {
        padding: 10px 12px;
        font-size: 0.8rem;
      }
    }
    
    @media (max-width: 400px) {
      a {
        padding: 8px 10px;
        font-size: 0.75rem;
      }
    }
  }
  
  .bubble {
    background: var(--background);
    top: anchor(top);
    right: anchor(right);
    bottom: anchor(bottom);
    left: anchor(left);
    position: absolute;
    transition: all 0.2s;
    border-radius: 500px;
    
    &.active {
      position-anchor: --active;
      z-index: 2;
      background: linear-gradient(180deg, var(--background), var(--muted));
      box-shadow: inset 0 2px 7px var(--background);
    }
    
    &.hover {
      z-index: 1;
      background: linear-gradient(180deg, var(--border), color-mix(in oklch, var(--foreground) 70%, var(--background) 30%));
      box-shadow: inset 0 2px 7px color-mix(in oklch, var(--background) 16%, transparent);
      position-anchor: --nav;
    }
  }
</style>

<script>
  const links = document.querySelectorAll(".nav a");
  const sections = new Map();
  let isScrolling = false;
  let scrollTimeout: ReturnType<typeof setTimeout> | undefined;
  let updateTimeout: ReturnType<typeof setTimeout> | undefined;
  let currentActiveLink: Element | null = null;

  // Build map of links to sections
  links.forEach((link) => {
    const href = link.getAttribute("href");
    if (href && href.startsWith("#")) {
      const section = document.querySelector(href);
      if (section) {
        sections.set(link, section);
      }
    }
  });

  // Update active link (prevents unnecessary DOM updates)
  function setActiveLink(activeLink: Element | null) {
    if (currentActiveLink === activeLink) return;
    
    links.forEach((l) => l.classList.remove("active"));
    if (activeLink) {
      activeLink.classList.add("active");
      currentActiveLink = activeLink;
    }
  }

  // Find which section should be active based on scroll position
  function updateActiveSection() {
    if (isScrolling) return;

    const triggerPoint = window.innerHeight * 0.4; // 40% from top
    let bestSection = null;
    let bestDistance = Infinity;

    sections.forEach((section, link) => {
      const rect = section.getBoundingClientRect();
      const sectionTop = rect.top;
      const sectionBottom = rect.bottom;
      
      // Skip sections completely out of viewport
      if (sectionBottom < 0 || sectionTop > window.innerHeight) return;
      
      // Calculate distance from trigger point
      let distance;
      if (sectionTop <= triggerPoint && sectionBottom >= triggerPoint) {
        distance = 0; // Section spans trigger point - perfect match
      } else if (sectionTop > triggerPoint) {
        distance = sectionTop - triggerPoint; // Below trigger
      } else {
        distance = triggerPoint - sectionBottom; // Above trigger
      }
      
      // Keep track of closest section
      if (distance < bestDistance) {
        bestDistance = distance;
        bestSection = link;
      }
    });

    if (bestSection) {
      setActiveLink(bestSection);
    }
  }

  // Intersection Observer: triggers update when sections enter/exit viewport
  const observer = new IntersectionObserver(() => {
    clearTimeout(updateTimeout);
    updateTimeout = setTimeout(updateActiveSection, 100); // Debounce to prevent flickering
  }, {
    root: null,
    threshold: [0, 1] // Only track enter/exit
  });

  // Observe all sections
  sections.forEach((section) => observer.observe(section));

  // Initial update
  updateActiveSection();

  // Hide navbar and socials bar when wood deck section enters viewport
  const navWrap = document.querySelector('.nav-wrap') as HTMLElement;
  const socialsBar = document.querySelector('.socials-bar') as HTMLElement;
  const woodDeck = document.querySelector('#wood-deck');
  
  if (navWrap && socialsBar && woodDeck) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const rect = entry.boundingClientRect;
          
          // Show navbar only if section is below the trigger zone (not yet reached)
          // Hide if section is intersecting or has scrolled past (above viewport)
          if (entry.isIntersecting || rect.top < 0) {
            navWrap.style.opacity = '0';
            navWrap.style.pointerEvents = 'none';
            socialsBar.style.opacity = '0';
            socialsBar.style.pointerEvents = 'none';
          } else {
            navWrap.style.opacity = '1';
            navWrap.style.pointerEvents = 'auto';
            socialsBar.style.opacity = '1';
            socialsBar.style.pointerEvents = 'auto';
          }
        });
      },
      {
        rootMargin: '0px 0px -50% 0px',
      }
    );
    
    observer.observe(woodDeck);
  }

  // Handle link clicks
  links.forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      isScrolling = true;
      setActiveLink(link);
      
      const href = link.getAttribute("href");
      if (href?.startsWith("#")) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: "smooth" });
          
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            isScrolling = false;
            updateActiveSection();
          }, 1000);
        }
      }
    });
  });
</script>