---
import logoSvg from '../data/logo.svg?raw';
import '../styles/pill-nav.css';
import Link from './Link.astro';
import NavLinks from './NavLinks.astro';
---

<div class="top-bar pointer-events-none" data-top-bar>
  <div class="top-bar-container pointer-events-none">
    <!-- Left: Logo + Location -->
    <div class="pill-container left-group pointer-events-auto">
      <a href="#hero" class="logo-link">
        <div class="size-9 logo" data-navbar-logo set:html={logoSvg} />
      </a>
      <span class="location-text">Hamilton, ON</span>
    </div>

    <!-- Center: Navigation (desktop only) -->
    <div class="center-nav pointer-events-none">
      <NavLinks variant="pill" class="pointer-events-auto" />
    </div>

    <!-- Right: Phone -->
    <div class="pill-container right-group pointer-events-auto">
      <Link href="tel:+1234567890">
        +1 416 828 2380
      </Link>
    </div>
  </div>
</div>

<style>
  .top-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: transparent;
    z-index: 1000;
    padding: 0.75rem 1rem;
    transition: opacity 0.3s ease-out, transform 0.5s ease-out;
    
    /* Initially hidden for splash reveal */
    opacity: 0;
    transform: translateY(-10px);
  }
  
  /* Reveal after splash - use transition instead of animation */
  html.splash-revealed .top-bar {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.4s;
  }

  /* Hidden state for wood deck section */
  .top-bar.nav-hidden {
    opacity: 0 !important;
    pointer-events: none;
    transition-delay: 0s;
  }

  .top-bar-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.2rem;
  }

  .left-group {
    display: flex;
    align-items: center;
    gap: 0rem;
    padding: 4px;
  }

  .logo-link {
    padding: 0.4rem 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 500px;
    transition: background 0.3s ease-out;
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .logo :global(path) {
    fill: var(--primary);
  }

  .location-text {
    padding: clamp(0.3rem, 2vw + 0.2rem, 0.4rem) clamp(0.5rem, 2vw + 0.5rem, 0.75rem) clamp(0.3rem, 2vw + 0.2rem, 0.4rem) 0.25rem;
    font-size: var(--fluid-sm);
    color: var(--foreground);
    white-space: nowrap;
    border-radius: 500px;
  }

  .center-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .right-group {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw + 0.5rem, 1rem);
    padding: 4px;
  }

  .right-group :global(a) {
    padding: clamp(0.3rem, 2vw + 0.2rem, 0.4rem) clamp(0.75rem, 2vw + 0.5rem, 1rem);
    display: inline-block;
    color: var(--foreground);
    text-decoration: none;
    font-size: var(--fluid-sm);
    white-space: nowrap;
    border-radius: 500px;
    transition: background 0.3s ease-out;
  }

  .logo-link {
    padding: clamp(0.3rem, 2vw + 0.2rem, 0.4rem) clamp(0.25rem, 2vw + 0.2rem, 0.5rem);
  }

  /* Mobile: hide center nav */
  @media (max-width: 768px) {
    .center-nav {
      display: none;
    }

    .top-bar-container {
      gap: 1rem;
    }

    .left-group {
      gap: 0rem;
      padding: 3px;
    }
  }

  @media (max-width: 640px) {
    .top-bar {
      padding: 0.5rem 0.75rem;
    }

    .right-group {
      gap: 0.5rem;
      padding: 3px;
    }
  }
</style>
