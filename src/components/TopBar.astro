---
import logoSvg from '../data/logo.svg?raw';
import Link from './Link.astro';
import NavLinks from './NavLinks.astro';
---

<div class="top-bar" data-top-bar>
  <div class="top-bar-container">
    <!-- Left: Logo + Location -->
    <div class="left-group">
      <a href="#hero" class="logo-link">
        <div class="size-12 logo" data-navbar-logo set:html={logoSvg} />
      </a>
      <span class="location-text">Hamilton, ON</span>
    </div>

    <!-- Center: Navigation (desktop only) -->
    <div class="center-nav">
      <NavLinks variant="pill" />
    </div>

    <!-- Right: Phone -->
    <div class="right-group">
      <Link href="tel:+1234567890">
        +1 (234) 567-890
      </Link>
    </div>
  </div>
</div>

<style>
  .top-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: transparent;
    z-index: 1000;
    padding: 0.75rem 1rem;
    transition: opacity 0.3s ease-out, transform 0.5s ease-out;
    
    /* Initially hidden for splash reveal */
    opacity: 0;
    transform: translateY(-10px);
  }
  
  /* Reveal after splash - use transition instead of animation */
  html.splash-revealed .top-bar {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.4s;
  }

  /* Hidden state for wood deck section */
  .top-bar.nav-hidden {
    opacity: 0 !important;
    pointer-events: none;
    transition-delay: 0s;
  }

  .top-bar-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .left-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .logo :global(path) {
    fill: var(--primary);
  }

  .location-text {
    font-size: 0.9rem;
    color: var(--foreground);
    white-space: nowrap;
  }

  .center-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .right-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Mobile: hide center nav */
  @media (max-width: 768px) {
    .center-nav {
      display: none;
    }

    .top-bar-container {
      gap: 1rem;
    }

    .left-group {
      gap: 0.5rem;
    }

    .location-text {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 640px) {
    .top-bar {
      padding: 0.5rem 0.75rem;
    }

    .right-group {
      gap: 0.5rem;
    }
  }
</style>
