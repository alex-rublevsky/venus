---
import Link from './Link.astro';
---
<div 
    class="relative h-dvh footer-wrapper"
>
    <div class="fixed bottom-0 h-dvh w-full" style="overflow-x: clip; overflow-y: visible;">
        <div class="absolute inset-0 bg-primary" style="clip-path: polygon(0% 0, 100% 0%, 100% 100%, 0 100%);"></div>
        <footer class="relative h-full flex flex-col items-center justify-between pt-16 pb-4 px-(--section-padding-x)">
            <div id="contact" class="contact-section flex-1 flex items-center justify-center w-full footer-content">
                <div class="contact-content-wrapper">
                    <div class="contact-links-container">
                        <p class="consultation-label text-primary-foreground! border bg-muted/10 rounded p-2">
                            Book a Free Consultation
                        </p>
                        <Link
                            href="tel:+14168282380"
                            class="text-secondary! text-3xl lg:text-4xl text-left block"
                        >
                            +1 416 828 2380
                        </Link>
                        <Link
                            href="mailto:venusfence.1@gmail.com"
                            class="text-secondary! text-3xl lg:text-4xl text-left block"
                        >
                            venusfence.1@gmail.com
                        </Link>
                    </div>
                </div>
            </div>
            
            <div class="flex gap-2 flex-wrap justify-center items-center footer-content">
                
                <p class="text-center text-primary-foreground!">
                    Like the site?{" "}
                    <Link
                        href="https://www.rublevsky.studio"
                        class="text-secondary!"
                       
                      
                      
                    >
                        Contact the developer{" "}
                    </Link>
                </p>
                <p class="text-center text-primary-foreground/50!">
                    © All rights are reserved by the team of Venus Construction Group and it's owner Iqbal Masih. {new Date().getFullYear()}
                </p>
              
            </div>
        </footer>
    </div>
</div>

<style>
    .footer-wrapper {
        overflow: visible !important;
    }

    footer {
        position: relative;
        overflow: visible !important;
    }

    .contact-content-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .contact-links-container {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-align: left;
    }

    .consultation-label {
        position: static;
        transform: none;
        white-space: nowrap;
        width: fit-content;
        display: inline-block;
        cursor: pointer;
        transition: transform 0.2s ease-in-out;
    }

    .consultation-label:hover {
        transform: scale(1.01) rotate(1deg);
    }

    .consultation-label:active {
        transform: scale(0.99);
    }

    @media (min-width: 640px) {
        .contact-links-container {
            margin-top: 80px;
        }
        
        .consultation-label {
            position: absolute;
            left: -4.5em;
            top: -2.5em;
            transform: rotate(-10deg);
            transform-origin: center;
        }

        .consultation-label:hover {
            transform: scale(1.01) rotate(-9deg);
        }

        .consultation-label:active {
            transform: scale(0.99) rotate(-10deg);
        }
    }

    @media (min-width: 768px) {
        .consultation-label {
            left: -4.5em;
            top: -2.5em;
        }
    }

    @media (min-width: 1024px) {
        .consultation-label {
            left: -4.5em;
            top: -2.5em;
        }
    }

    .footer-content {
        opacity: 0;
        animation: footer-reveal linear both;
        animation-timeline: scroll(root);
        animation-range: 150vh 160vh;
    }

    @keyframes footer-reveal {
        to {
            opacity: 1;
        }
    }

    @supports not (animation-timeline: scroll()) {
        .footer-content {
            opacity: 1;
        }
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
        var phoneLink = document.querySelector('a[href^="tel:"]');
        var emailLink = document.querySelector('a[href^="mailto:"]');
        var consultationLabel = document.querySelector('.consultation-label');

        if (phoneLink) {
            phoneLink.addEventListener('click', function () {
                window.posthog?.capture('contact_phone_clicked', {
                    phone_number: phoneLink.getAttribute('href').replace('tel:', ''),
                    location: 'footer'
                });
            });
        }

        if (emailLink) {
            emailLink.addEventListener('click', function () {
                window.posthog?.capture('contact_email_clicked', {
                    email: emailLink.getAttribute('href').replace('mailto:', ''),
                    location: 'footer'
                });
            });
        }

        if (consultationLabel) {
            consultationLabel.addEventListener('click', function () {
                window.posthog?.capture('consultation_cta_clicked', {
                    location: 'footer'
                });
            });
        }
    });
</script>
