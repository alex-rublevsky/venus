---
import '../styles/pill-nav.css';

export interface Props {
  variant?: 'pill' | 'inline';
  class?: string;
}

const { variant = 'pill', class: className } = Astro.props;

const navItems = [
  { label: 'House Renovation', href: '#gallery-0' },
  { label: 'Decks', href: '#gallery-1' },
  { label: 'Fences', href: '#gallery-2' },
];
---

<div class:list={['pill-container', variant, className]} data-nav-container={variant}>
  <div class="pill-bubble active"></div>
  <div class="pill-bubble hover"></div>
  <nav class="pill-nav-links" data-nav-links>
    {navItems.map((item, index) => (
      <a 
        href={item.href} 
        class="pill-nav-link"
        data-nav-link
        data-text={item.label}
      >
        {item.label}
      </a>
    ))}
  </nav>
</div>

<style>
  /* Inline variant - simpler styling without pill container */
  .pill-container.inline .pill-nav-links {
    margin: 0;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var navLinks = document.querySelectorAll('[data-nav-link]');
    navLinks.forEach(function (link) {
      link.addEventListener('click', function () {
        window.posthog?.capture('nav_link_clicked', {
          label: link.getAttribute('data-text') || link.textContent?.trim(),
          href: link.getAttribute('href')
        });
      });
    });
  });
</script>
