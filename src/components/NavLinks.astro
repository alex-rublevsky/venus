---
export interface Props {
  variant?: 'pill' | 'inline';
  class?: string;
}

const { variant = 'pill', class: className } = Astro.props;

const navItems = [
  { label: 'House Renovation', href: '#gallery-0' },
  { label: 'Decks', href: '#gallery-1' },
  { label: 'Fences', href: '#gallery-2' },
];
---

<div class:list={['nav-links-container', variant, className]} data-nav-container={variant}>
  <div class="bubble active"></div>
  <div class="bubble hover"></div>
  <nav class="nav-links" data-nav-links>
    {navItems.map((item, index) => (
      <a 
        href={item.href} 
        class:list={[index === 0 && 'active']}
        data-nav-link
      >
        {item.label}
      </a>
    ))}
  </nav>
</div>

<style>
  .nav-links-container {
    position: relative;
    width: fit-content;
  }

  /* Pill variant - with bubble effects and background */
  .nav-links-container.pill {
    border: 1px solid var(--border);
    border-radius: 500px;
    box-shadow: inset 10px 0 10px var(--foreground);
    background: linear-gradient(
      0deg, 
      color-mix(in oklch, var(--foreground) 95%, var(--background) 5%), 
      color-mix(in oklch, var(--foreground) 85%, var(--background) 15%)
    );
    
    &:after {
      content: "";
      display: block;
      position: absolute;
      inset: -5px;
      background: linear-gradient(
        180deg, 
        var(--border), 
        color-mix(in oklch, var(--foreground) 70%, var(--background) 30%)
      );
      border-radius: 500px;
      z-index: -1;
    }
  }
  
  .nav-links {
    width: fit-content;
    anchor-name: --nav;
    margin: 4px;
    display: flex;
    flex-wrap: nowrap;
    gap: 2px;
    position: relative;
  }

  /* Inline variant - simpler styling */
  .nav-links-container.inline .nav-links {
    margin: 0;
  }
  
  .nav-links a {
    z-index: 10;
    position: relative;
    display: inline-block;
    padding: 0.4rem 1rem;
    color: var(--background);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
    transition: color 0.2s;
    
    &:before {
      content: "";
      display: block;
      position: absolute;
      inset: 0;
      opacity: 0.2;
    }
    
    &.active {
      anchor-name: --active;
      color: var(--foreground);
    }
    
    &:hover:before {
      anchor-name: --nav;
    }
  }
  
  .bubble {
    background: var(--background);
    top: anchor(top);
    right: anchor(right);
    bottom: anchor(bottom);
    left: anchor(left);
    position: absolute;
    transition: all 0.2s;
    border-radius: 500px;
    
    &.active {
      position-anchor: --active;
      z-index: 2;
      background: linear-gradient(180deg, var(--background), var(--muted));
      box-shadow: inset 0 2px 7px var(--background);
    }
    
    &.hover {
      z-index: 1;
      background: linear-gradient(
        180deg, 
        var(--border), 
        color-mix(in oklch, var(--foreground) 70%, var(--background) 30%)
      );
      box-shadow: inset 0 2px 7px color-mix(in oklch, var(--background) 16%, transparent);
      position-anchor: --nav;
    }
  }

  /* Responsive sizing */
  @media (max-width: 640px) {
    .nav-links a {
      padding: 10px 16px;
      font-size: 0.85rem;
    }
  }
  
  @media (max-width: 480px) {
    .nav-links a {
      padding: 10px 12px;
      font-size: 0.8rem;
    }
  }
  
  @media (max-width: 400px) {
    .nav-links a {
      padding: 8px 10px;
      font-size: 0.75rem;
    }
  }
</style>
