<style>
    .socials-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background-color: transparent;
        z-index: 1000;
        padding: 0.75rem 1rem;
        transition: opacity 0.3s ease-out;
        
        /* Initially hidden for splash reveal */
        opacity: 0;
        transform: translateY(-10px);
    }
    
    /* Animate in after splash reveals */
    html.splash-revealed .socials-bar {
        animation: fade-in-down 0.5s ease-out 0.4s forwards;
    }
    
    @keyframes fade-in-down {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .socials-container {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

  
    .logo {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .logo :global(svg) {
        width: 100%;
        height: 100%;
        display: block;
    }

    .logo :global(path) {
        fill: var(--primary);
    }

    .socials-group {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #f3f4f6;
        color: #374151;
        transition: all 0.2s;
    }

    .social-link:hover {
        background-color: #e5e7eb;
        transform: translateY(-2px);
    }

    .social-link svg {
        width: 20px;
        height: 20px;
    }

  

    @media (max-width: 640px) {
        .socials-bar {
            padding: 0.5rem 0.75rem;
        }

        .socials-group {
            gap: 0.5rem;
        }

        .social-link {
            width: 36px;
            height: 36px;
        }

     
    }
</style>
