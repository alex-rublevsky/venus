---
export const prerender = false;
import GeneralLayout from '../../layouts/GeneralLayout.astro';
const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
	invalid: 'Invalid password. Please try again.',
	config: 'Analytics is not configured. Contact the administrator.',
};
const errorMessage = error ? errorMessages[error] ?? null : null;
---
<GeneralLayout noFooter noindex>
	<div class="login-container">
		<div class="login-card">
			<h1>Analytics</h1>
			<p class="login-subtitle">Enter the password to view analytics</p>
			<form method="post" action="/api/analytics-auth" enctype="application/x-www-form-urlencoded" class={`login-form ${errorMessage ? 'has-error' : ''}`}>
				<input
					type="password"
					name="password"
					placeholder="Password"
					autocomplete="current-password"
					required
					autofocus
				/>
				<button type="submit" class={errorMessage ? 'error' : ''}>
					{error === 'invalid' ? 'Invalid password' : 'Sign in'}
				</button>
				{errorMessage && <p class="login-error">{errorMessage}</p>}
			</form>
		</div>
	</div>
</GeneralLayout>

<style>
	.login-container {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		background-color: var(--background);
	}
	.login-card {
		width: 100%;
		max-width: 22rem;
		padding: 2rem;
		background-color: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
	}
	.login-card h1 {
		margin: 0 0 0.25rem;
		font-size: 1.5rem;
	}
	.login-subtitle {
		margin: 0 0 1.5rem;
		font-size: var(--fluid-sm);
		color: var(--muted-foreground);
	}
	.login-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.login-form input {
		padding: 0.625rem 0.875rem;
		font-size: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background-color: var(--background);
		color: var(--foreground);
	}
	.login-form input:focus {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	.login-form button {
		padding: 0.625rem 1rem;
		font-size: 1rem;
		font-weight: 500;
		color: var(--primary-foreground);
		background-color: var(--primary);
		border: none;
		border-radius: var(--radius-md);
		cursor: pointer;
	}
	.login-form button:hover {
		opacity: 0.9;
	}
	.login-form button.error {
		background-color: oklch(0.6 0.2 25);
	}
.login-form.has-error input {
		border-color: oklch(0.6 0.2 25);
	}
	.login-error {
		margin: 0;
		font-size: var(--fluid-sm);
		color: var(--destructive, oklch(0.6 0.2 25));
	}
</style>
