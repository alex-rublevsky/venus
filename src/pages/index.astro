---
import GallerySection from '../components/GallerySection.astro';
import HeroSection from '../components/Hero.astro';
import PartnersSection from '../components/PartnersSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import WoodDeckSection from '../components/WoodDeckSection.astro';
import Layout from '../layouts/Layout.astro';
import PerspectiveTransitionWrapper from '../components/PerspectiveTransitionWrapper.astro';
import { galleryCategories } from '../data/galleryData.ts';

const [housesCategory, decksCategory, fencesCategory] = galleryCategories;
---

<Layout>
	<PerspectiveTransitionWrapper>
		<HeroSection slot="hero"/>
		<GallerySection slot="content" categories={[housesCategory]} showTitle={true} categoryIndexOffset={0} insidePerspectiveWrapper={true} />
	</PerspectiveTransitionWrapper>
	<GallerySection categories={[decksCategory]} showTitle={true} categoryIndexOffset={1} />
	<GallerySection categories={[fencesCategory]} showTitle={true} categoryIndexOffset={2} />
	<PartnersSection/>
	<TestimonialsSection/>
	<WoodDeckSection/>
</Layout>
